{
  "schemaVersion": 1,
  "id": "mantle",
  "version": "${version}",

  "name": "Mantle (Unofficial Fabric Port)",
  "description": "Unofficial, largely AI-assisted (\"vibed\") port of SlimeKnights' Mantle to Fabric for 1.20.1, targeting the 1.11 line. Upstream code is SlimeKnights' and AlphaMode's; the MinecraftReconstruction migration work is largely AI-assisted and was carried out under human direction, review and validation. This is a library: it is meant to be installed alongside the Fabric Tinkers' Construct port, not on its own.",
  "authors": [
    "Slime Knights",
    "AlphaMode",
    "MinecraftReconstruction"
  ],
  "contributors": [
    "AI-assisted migration by MinecraftReconstruction agents"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/mantle-fabric-unofficial",
    "sources": "https://github.com/MinecraftReconstruction/Mantle-Fabric",
    "issues": "https://github.com/MinecraftReconstruction/Mantle-Fabric/issues"
  },

  "license": "MIT",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "slimeknights.mantle.Mantle",
      "slimeknights.mantle.testing.MantleSelfTest"
    ],
    "client": [
      "slimeknights.mantle.client.ClientEvents::onConstruct"
    ],
    "fabric-datagen": [
      "slimeknights.mantle.MantleData"
    ],
    "cardinal-components": [
      "slimeknights.mantle.util.OffhandCooldownTracker"
    ],
    "rei_client": [
      "slimeknights.mantle.plugin.rei.REIPlugin"
    ],
    "jei_mod_plugin": [
      "slimeknights.mantle.plugin.jei.JEIPlugin"
    ],
    "emi": [
      "slimeknights.mantle.plugin.emi.EMIPlugin"
    ]
  },
  "accessWidener": "mantle.accesswidener",
  "mixins": [
    "mantle.mixins.json"
  ],
  "custom": {
    "cardinal-components": [
      "mantle:offhand_cooldown"
    ]
  },
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabric": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "porting_lib_accessors": ">=${port_lib_accessors_version}",
    "porting_lib_attributes": ">=${port_lib_attributes_version}",
    "porting_lib_base": ">=${port_lib_base_version}",
    "porting_lib_core": ">=${port_lib_core_version}",
    "porting_lib_config": ">=${port_lib_config_version}",
    "porting_lib_common": ">=${port_lib_common_version}",
    "porting_lib_entity": ">=${port_lib_entity_version}",
    "porting_lib_extensions": ">=${port_lib_extensions_version}",
    "porting_lib_transfer": ">=${port_lib_transfer_version}",
    "porting_lib_fluids": ">=${port_lib_fluids_version}",
    "porting_lib_lazy_registration": ">=${port_lib_lazy_registration_version}",
    "porting_lib_loot": ">=${port_lib_loot_version}",
    "porting_lib_utility": ">=${port_lib_utility_version}",
    "porting_lib_models": ">=${port_lib_models_version}",
    "porting_lib_model_loader": ">=${port_lib_model_loader_version}",
    "porting_lib_networking": ">=${port_lib_common_version}",
    "porting_lib_tags": ">=${port_lib_tags_version}",
    "reach-entity-attributes": ">=${reach_entity_attributes_version}"
  }
}
